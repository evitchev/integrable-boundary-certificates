ring r = 0, (sX,sY,cX,cY), dp;
ideal I = 2655*sX - 36540*sY,
23010*cX - 163800*cY - 14455*sX - 807534,
-80753400*cX*sY + 1197050400*cY*sY + 45135*sX^2 + 506751336*sY,
1271302500*cX^2 - 18099900000*cX*cY - 89232507000*cX + 134152200000*cY^2 + 113582196000*cY - 296261125*sX^2 + 1263708059796;
LIB "primdec.lib"; LIB "elim.lib";
ideal G = std(I); "RAW dim:"; dim(G);
list pr = minAssGTZ(I); int i; "RAW minimal primes:"; size(pr);
poly h = (sX);
for (i=1;i<=size(pr);i++) { "  raw prime", i, "dim", dim(std(pr[i])), "inside h=0 (excluded):", reduce(h, std(pr[i]))==0, " sX=0 on it:", reduce(sX, std(pr[i]))==0; }
def SS = sat(I, h); "typeof sat:"; typeof(SS); ideal J = SS; ideal GJ = std(J); "SAT dim:"; dim(GJ); "SAT vdim (solutions with mult.):"; vdim(GJ);
ideal Jr = radical(J); "radical vdim:"; vdim(std(Jr));
list pd = minAssGTZ(J); "SAT minimal primes:"; size(pd);
ring s = 0, (sX,sY,cX,cY), lp; option(redSB); list pd = imap(r, pd); int j;
for (j=1;j<=size(pd);j++) { ideal L = std(pd[j]); "--- SAT prime", j, " vdim", vdim(L); L; write(":w comp_h2a_t9o4_" + string(j) + ".txt", L); kill L; }
write(":w ncomp_h2a_t9o4.txt", size(pd));
quit;
