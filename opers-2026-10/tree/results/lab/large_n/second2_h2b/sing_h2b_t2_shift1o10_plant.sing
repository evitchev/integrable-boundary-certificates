ring r = 0, (sX,sY,cX,cY,pi_rot), dp;
ideal I = 44834790*cX*pi_rot*sX - 1033882200*cX*sY - 296957700*cY*pi_rot*sX + 12167998200*cY*sY + 74724650*pi_rot^3*sX^2 - 3101646600*pi_rot^2*sX*sY - 2247969789*pi_rot*sX + 16649877537*sY,
156095940000*cX^2 - 2067764400000*cX*cY + 936575640000*cX*pi_rot^2*sX - 1010384124750*cX*pi_rot*sX - 15652976508000*cX + 12167998200000*cY^2 - 6203293200000*cY*pi_rot^2*sX + 6692154592500*cY*pi_rot*sX + 33299755074000*cY + 780479700000*pi_rot^4*sX^2 - 1683973541250*pi_rot^3*sX^2 - 46958929524000*pi_rot^2*sX + 50659610265225*pi_rot*sX + 318621561106626,
32011980*cX*sX - 1033882200*cX*sY - 212027400*cY*sX + 12167998200*cY*sY + 53353300*pi_rot^2*sX^2 - 1033882200*pi_rot^2*sX*sY - 1605047418*sX + 16649877537*sY,
78047970000*cX^2 - 1033882200000*cX*cY + 156095940000*cX*pi_rot^2*sX - 222877404750*cX*sX - 7826488254000*cX + 6083999100000*cY^2 - 1033882200000*cY*pi_rot^2*sX + 1476200992500*cY*sX + 16649877537000*cY + 78047970000*pi_rot^4*sX^2 - 371462341250*pi_rot^2*sX^2 - 7826488254000*pi_rot^2*sX + 11174841513225*sX + 159310780553313,
7656625785600000*cX^2 - 92658149337600000*cX*cY + 76566257856000000*cX*pi_rot^2*sX - 2279317356192240000*cX*pi_rot*sY - 1087652242974528000*cX + 352654150464000000*cY^2 - 463290746688000000*cY*pi_rot^2*sX + 17350027636687200000*cY*pi_rot*sY + 3905056959471360000*cY + 89327300832000000*pi_rot^4*sX^2 - 3798862260320400000*pi_rot^3*sX*sY - 5438261214872640000*pi_rot^2*sX + 96061319681791464000*pi_rot*sY + 37902853135487007360;
LIB "primdec.lib"; LIB "elim.lib";
ideal G = std(I); "RAW dim:"; dim(G);
poly h = (pi_rot)*(sX)*(2310*cX - 15300*cY + 3850*pi_rot^2*sX - 115821)*(118590000*cX^2 - 1435140000*cX*cY + 1185900000*cX*pi_rot^2*sX - 16846151700*cX + 5462100000*cY^2 - 7175700000*cY*pi_rot^2*sX + 60483654000*cY + 1383550000*pi_rot^4*sX^2 - 84230758500*pi_rot^2*sX + 587060080929);
def SS = sat(I, h); "typeof sat:"; typeof(SS); ideal J = SS; ideal GJ = std(J); "SAT dim:"; dim(GJ); "SAT vdim (solutions with mult.):"; vdim(GJ);
ideal Jr = radical(J); "radical vdim:"; vdim(std(Jr));
list pd = minAssGTZ(J); "SAT minimal primes:"; size(pd);
ring s = 0, (sX,sY,cX,cY,pi_rot), lp; option(redSB); list pd = imap(r, pd); int j;
for (j=1;j<=size(pd);j++) { ideal L = std(pd[j]); "--- SAT prime", j, " vdim", vdim(L); L; write(":w comp_h2b_t2_shift1o10_plant_" + string(j) + ".txt", L); kill L; }
write(":w ncomp_h2b_t2_shift1o10_plant.txt", size(pd));
setring r; "RAW (unsaturated) decomposition, informational:"; list pr = minAssGTZ(I); int i; "RAW minimal primes:"; size(pr);
for (i=1;i<=size(pr);i++) { "  raw prime", i, "dim", dim(std(pr[i])), "inside h=0 (excluded):", reduce(h, std(pr[i]))==0, " sX=0 on it:", reduce(sX, std(pr[i]))==0; }
quit;
