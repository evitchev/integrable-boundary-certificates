ring r = 0, (sX,sY,cX,cY,pi_rot), dp;
ideal I = 1801800*cX*pi_rot*sX - 2784600*cX*sY - 11934000*cY*pi_rot*sX + 32772600*cY*sY + 3003000*pi_rot^3*sX^2 - 8353800*pi_rot^2*sX*sY - 90340380*pi_rot*sX + 44843841*sY,
30030000*cX^2 - 397800000*cX*cY + 180180000*cX*pi_rot^2*sX - 300300000*cX*pi_rot*sX - 3011346000*cX + 2340900000*cY^2 - 1193400000*cY*pi_rot^2*sX + 1989000000*cY*pi_rot*sX + 6406263000*cY + 150150000*pi_rot^4*sX^2 - 500500000*pi_rot^3*sX^2 - 9034038000*pi_rot^2*sX + 15056730000*pi_rot*sX + 61296952887,
-300300*cX*sX - 2784600*cX*sY + 1989000*cY*sX + 32772600*cY*sY - 500500*pi_rot^2*sX^2 - 2784600*pi_rot^2*sX*sY + 15056730*sX + 44843841*sY,
30030000*cX^2 - 397800000*cX*cY + 60060000*cX*pi_rot^2*sX - 45045000*cX*sX - 3011346000*cX + 2340900000*cY^2 - 397800000*cY*pi_rot^2*sX + 298350000*cY*sX + 6406263000*cY + 30030000*pi_rot^4*sX^2 - 75075000*pi_rot^2*sX^2 - 3011346000*pi_rot^2*sX + 2258509500*sX + 61296952887,
3320520000*cX^2 - 40183920000*cX*cY + 33205200000*cX*pi_rot^2*sX - 63146160000*cX*pi_rot*sY - 471692247600*cX + 152938800000*cY^2 - 200919600000*cY*pi_rot^2*sX + 480664800000*cY*pi_rot*sY + 1693542312000*cY + 38739400000*pi_rot^4*sX^2 - 105243600000*pi_rot^3*sX*sY - 2358461238000*pi_rot^2*sX + 2661280776000*pi_rot*sY + 16437682266012;
LIB "primdec.lib"; LIB "elim.lib";
ideal G = std(I); "RAW dim:"; dim(G);
poly h = (pi_rot)*(sX)*(2310*cX - 15300*cY + 3850*pi_rot^2*sX - 115821)*(118590000*cX^2 - 1435140000*cX*cY + 1185900000*cX*pi_rot^2*sX - 16846151700*cX + 5462100000*cY^2 - 7175700000*cY*pi_rot^2*sX + 60483654000*cY + 1383550000*pi_rot^4*sX^2 - 84230758500*pi_rot^2*sX + 587060080929);
def SS = sat(I, h); "typeof sat:"; typeof(SS); ideal J = SS; ideal GJ = std(J); "SAT dim:"; dim(GJ); "SAT vdim (solutions with mult.):"; vdim(GJ);
ideal Jr = radical(J); "radical vdim:"; vdim(std(Jr));
list pd = minAssGTZ(J); "SAT minimal primes:"; size(pd);
ring s = 0, (sX,sY,cX,cY,pi_rot), lp; option(redSB); list pd = imap(r, pd); int j;
for (j=1;j<=size(pd);j++) { ideal L = std(pd[j]); "--- SAT prime", j, " vdim", vdim(L); L; write(":w comp_h2b_t2_shift1o10_" + string(j) + ".txt", L); kill L; }
write(":w ncomp_h2b_t2_shift1o10.txt", size(pd));
setring r; "RAW (unsaturated) decomposition, informational:"; list pr = minAssGTZ(I); int i; "RAW minimal primes:"; size(pr);
for (i=1;i<=size(pr);i++) { "  raw prime", i, "dim", dim(std(pr[i])), "inside h=0 (excluded):", reduce(h, std(pr[i]))==0, " sX=0 on it:", reduce(sX, std(pr[i]))==0; }
quit;
