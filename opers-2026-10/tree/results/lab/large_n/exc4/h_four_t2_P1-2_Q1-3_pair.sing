ww*z - 1,
36*ii - 103,
-5184*ee*z^5 + 8748*r11*r12^3*z^2 - 110808*r11*r12^2*z^3 + 412128*r11*r12*z^4 - 279936*r11*z^5 - 2187*r12^5 + 43740*r12^4*z - 337932*r12^3*z^2 + 34992*r12^2*z^4 + 1280232*r12^2*z^3 - 186624*r12*z^5 - 2509344*r12*z^4 + 46656*z^6 + 2285092*z^5;
